  {
    "id": "chunwang",
    "poemId": "df-chunwang",
    "title": "春望",
    "author": "杜甫",
    "era": "唐",
    "duration": 62,
    "voiceRate": 115,
    "tagline": "一城春色，写不尽家国之思",
    "location": "长安 · 757年春",
    "opening": "长安的春天，又来了。山河依旧，城中却是深深的草木。",
    "ending": "春花与鸟鸣，为什么让诗人落泪？再读一遍，听见他的牵挂。",
    "lines": [
      "国破山河在，",
      "城春草木深。",
      "感时花溅泪，",
      "恨别鸟惊心。",
      "烽火连三月，",
      "家书抵万金。",
      "白头搔更短，",
      "浑欲不胜簪。"
    ],
